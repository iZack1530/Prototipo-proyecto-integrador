<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HorizonMythos.Simulador</RootNamespace>
    <AssemblyName>HorizonMythos.Simulador</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorizonMythos.Nucleo\HorizonMythos.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- El simulador usa el mismo catálogo v5 que las pruebas de paridad. -->
    <None Include="..\..\pruebas\HorizonMythos.Nucleo.Pruebas\datos_prueba.json"
          Link="datos_prueba.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
