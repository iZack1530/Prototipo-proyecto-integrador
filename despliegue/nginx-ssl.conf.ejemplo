# Renombra este archivo a nginx-ssl.conf dentro de conf.d (o cópialo al servidor)
# y sustituye lab.EJEMPLO.com por tu dominio real. Requiere que certbot haya
# emitido el certificado en /etc/letsencrypt/live/<dominio>/.
map $http_upgrade $connection_upgrade_ssl {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name lab.EJEMPLO.com;

    server_tokens off;
    client_max_body_size 20m;

    ssl_certificate     /etc/letsencrypt/live/lab.EJEMPLO.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lab.EJEMPLO.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location ~ /\.(?!well-known) {
        deny all;
    }
    location ^~ /despliegue/ { deny all; }
    location ^~ /src/ { deny all; }
    location ^~ /pruebas/ { deny all; }
    location ^~ /herramientas/ { deny all; }
    location ^~ /archivo/ { deny all; }
    location ^~ /.github/ { deny all; }
    location ~* \.(csproj|sln|md)$ { deny all; }

    location ^~ /laboratorio/ {
        auth_basic "Laboratorio interno";
        auth_basic_user_file /etc/nginx/auth/htpasswd;
        root /var/www/horizon;
        try_files $uri $uri/ /laboratorio/index.html;
    }

    location /api/ {
        proxy_pass http://api_horizon;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hub/ {
        proxy_pass http://api_horizon;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_ssl;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location /media/ {
        alias /var/www/media/;
        try_files $uri =404;
    }

    location / {
        root /var/www/horizon;
        try_files $uri $uri/ $uri.html =404;
        error_page 404 /404.html;
    }
}
