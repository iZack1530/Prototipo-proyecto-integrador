# Copia este archivo a .env y rellena los valores. .env NO se sube al repositorio.

# PostgreSQL
POSTGRES_DB=horizon_mythos
POSTGRES_USER=horizon
POSTGRES_PASSWORD=cambia-esta-contrasena

# Sitio público (lo usan CORS y los enlaces de recuperación)
SITIO_URL=https://lab.ejemplo.com

# SMTP (opcional; si se deja vacío, los correos solo se registran en el log)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
SMTP_USAR_SSL=true

# Combate
SEGUNDOS_TURNO=45
